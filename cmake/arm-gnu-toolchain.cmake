# Shared, pinned toolchain for the chassis and Linux FS-i6X firmware.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if(NOT ARM_GNU_TOOLCHAIN_ROOT)
    if(DEFINED ENV{ARM_GNU_TOOLCHAIN_ROOT} AND NOT "$ENV{ARM_GNU_TOOLCHAIN_ROOT}" STREQUAL "")
        set(ARM_GNU_TOOLCHAIN_ROOT "$ENV{ARM_GNU_TOOLCHAIN_ROOT}")
    else()
        set(ARM_GNU_TOOLCHAIN_ROOT "$ENV{HOME}/.local/opt/arm-gnu-toolchain-15.3.rel1-x86_64-arm-none-eabi")
    endif()
endif()
set(ARM_GNU_TOOLCHAIN_ROOT "${ARM_GNU_TOOLCHAIN_ROOT}" CACHE PATH "Arm GNU 15.3.Rel1 installation root")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ARM_GNU_TOOLCHAIN_ROOT)

set(_arm_bin "${ARM_GNU_TOOLCHAIN_ROOT}/bin")
set(_arm_exe "")
if(CMAKE_HOST_WIN32)
    set(_arm_exe ".exe")
endif()
foreach(_tool gcc g++ ar ranlib objcopy size objdump nm strip ld)
    if(NOT EXISTS "${_arm_bin}/arm-none-eabi-${_tool}${_arm_exe}")
        message(FATAL_ERROR "Arm GNU 15.3.Rel1 tool missing: ${_arm_bin}/arm-none-eabi-${_tool}${_arm_exe}. Run tools/install_gcc15.sh or set ARM_GNU_TOOLCHAIN_ROOT.")
    endif()
endforeach()
execute_process(COMMAND "${_arm_bin}/arm-none-eabi-gcc${_arm_exe}" -dumpfullversion
    OUTPUT_VARIABLE _arm_version OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _arm_result)
if(NOT _arm_result EQUAL 0 OR NOT _arm_version STREQUAL "15.3.1")
    message(FATAL_ERROR "Expected GCC 15.3.1 from Arm GNU 15.3.Rel1; found '${_arm_version}' in ${ARM_GNU_TOOLCHAIN_ROOT}.")
endif()
if(EXISTS "${CMAKE_BINARY_DIR}/CMakeCache.txt" AND CMAKE_C_COMPILER AND
   NOT CMAKE_C_COMPILER STREQUAL "${_arm_bin}/arm-none-eabi-gcc${_arm_exe}")
    message(FATAL_ERROR "This build directory caches a different compiler (${CMAKE_C_COMPILER}). Use a fresh build directory; existing firmware is preserved.")
endif()

set(CMAKE_C_COMPILER "${_arm_bin}/arm-none-eabi-gcc${_arm_exe}")
set(CMAKE_CXX_COMPILER "${_arm_bin}/arm-none-eabi-g++${_arm_exe}")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
foreach(_pair "AR;ar" "RANLIB;ranlib" "OBJCOPY;objcopy" "SIZE;size" "OBJDUMP;objdump" "NM;nm" "STRIP;strip" "LINKER;ld")
    list(GET _pair 0 _variable)
    list(GET _pair 1 _tool)
    set(CMAKE_${_variable} "${_arm_bin}/arm-none-eabi-${_tool}${_arm_exe}" CACHE FILEPATH "Pinned Arm GNU ${_tool}" FORCE)
endforeach()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
