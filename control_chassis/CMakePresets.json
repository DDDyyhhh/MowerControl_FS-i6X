{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "STM32F407 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc15/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",
        "MOWER_IBUS_TIMEOUT_MS": "300"
      }
    },
    {
      "name": "release",
      "displayName": "STM32F407 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc15/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",
        "MOWER_IBUS_TIMEOUT_MS": "300"
      }
    },
    {
      "name": "exp3-hil",
      "inherits": "release",
      "displayName": "Ticket03 Experiment3 transport HIL",
      "binaryDir": "${sourceDir}/build/gcc15/exp3-hil",
      "cacheVariables": {
        "TICKET03_EXP3_HIL": "ON"
      }
    },
    {
      "name": "exp3-pwm-hil",
      "inherits": "exp3-hil",
      "displayName": "Ticket03 CH4/OK PWM bench HIL",
      "binaryDir": "${sourceDir}/build/gcc15/exp3-pwm-hil",
      "cacheVariables": {
        "TICKET03_EXP3_PWM_HIL": "ON"
      }
    },
    {
      "name": "mower-ok-release",
      "inherits": "release",
      "displayName": "Mower CH4/OK/CH7 accepted release",
      "binaryDir": "${sourceDir}/build/gcc15/mower-ok-release",
      "cacheVariables": {
        "MOWER_BLADE_OK": "ON",
        "TICKET03_EXP3_HIL": "OFF",
        "TICKET03_EXP3_PWM_HIL": "OFF",
        "MOWER_IBUS_TIMEOUT_MS": "300"
      }
    },
    {
      "name": "mower-ok-ibus-300ms",
      "inherits": "mower-ok-release",
      "displayName": "Mower 24V actuator / explicit 300ms i-BUS",
      "binaryDir": "${sourceDir}/build/gcc15/mower-ok-ibus-300ms",
      "cacheVariables": {
        "MOWER_IBUS_TIMEOUT_MS": "300"
      }
    },
    {
      "name": "mower-ok-ibus-100ms",
      "inherits": "mower-ok-release",
      "displayName": "Mower 24V actuator / 100ms i-BUS rollback",
      "binaryDir": "${sourceDir}/build/gcc15/mower-ok-ibus-100ms",
      "cacheVariables": {
        "MOWER_IBUS_TIMEOUT_MS": "100"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "exp3-hil",
      "configurePreset": "exp3-hil"
    },
    {
      "name": "exp3-pwm-hil",
      "configurePreset": "exp3-pwm-hil"
    },
    {
      "name": "flash-debug",
      "configurePreset": "debug",
      "targets": [
        "flash"
      ]
    },
    {
      "name": "flash-release",
      "configurePreset": "release",
      "targets": [
        "flash"
      ]
    },
    {
      "name": "flash-exp3-hil",
      "configurePreset": "exp3-hil",
      "targets": [
        "flash"
      ]
    },
    {
      "name": "flash-exp3-pwm-hil",
      "configurePreset": "exp3-pwm-hil",
      "targets": [
        "flash"
      ]
    },
    {
      "name": "mower-ok-release",
      "configurePreset": "mower-ok-release"
    },
    {
      "name": "mower-ok-ibus-300ms",
      "configurePreset": "mower-ok-ibus-300ms"
    },
    {
      "name": "mower-ok-ibus-100ms",
      "configurePreset": "mower-ok-ibus-100ms"
    }
  ]
}
